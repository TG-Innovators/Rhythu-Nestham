# Rythu Nestham — Environment Variables
# Copy this file to .env and fill in your Supabase project credentials

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (public key with 'anon' role, starting with eyJ...)
# CAUTION: Never use the service_role key here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
